# Edge ingress lane owns this file. Do not deploy Caddy/domain routing changes
# through the Route Ops runtime lane.
#
# Host ownership:
# - clever-route.cleversystem.ai      -> Route delivery-api in this compose project
# - clever-route-app.cleversystem.ai  -> Shopify dev/legacy app on external compose network
# - clever-admin.cleversystem.ai      -> Shopify main/admin app on external compose network
# - clever-kfood-app.cleversystem.ai  -> Shopify K-food app on external compose network
# Add new host blocks through the Edge Caddy deploy lane only after scope approval.

clever-route.cleversystem.ai {
	encode zstd gzip
	reverse_proxy delivery-api:3000 {
		# During SSM deploys the single delivery-api container is recreated.
		# Retry connection failures briefly so clients wait for the new healthy
		# container instead of receiving an immediate transient 502.
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}

clever-route-app.cleversystem.ai {
	encode zstd gzip
	reverse_proxy shopify-app-clever-route:3000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
clever-admin.cleversystem.ai {
	encode zstd gzip
	reverse_proxy shopify-app:3000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
clever-kfood-app.cleversystem.ai {
	encode zstd gzip
	reverse_proxy shopify-app-kfood:3000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
