NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL / Prisma
DATABASE_URL=postgresql://clever:clever@localhost:5432/clever_route
POSTGRES_DB=clever_route
POSTGRES_USER=clever
POSTGRES_PASSWORD=clever

# Driver API auth secret; required for driver login/session and route access APIs.
JWT_SECRET=change-me
# Register the DSV Driver app login/signup routes only when explicitly enabled.
CLEVER_DSV_DRIVER_AUTH_ENABLED=false
# Keyed fingerprint secret for the DSV Driver app's resident-number-front matching.
# Use at least 32 random characters and keep it in runtime secret storage.
DSV_DRIVER_IDENTITY_SECRET=

# Generic server-side master key for encrypting customer connector credentials in DB.
# Generate with: node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Internal-only API contract gate for WooCommerce credential onboarding.
# Do not use customer Woo keys/secrets here; operators enter those through the
# authenticated admin API and they are stored encrypted per shop/site.
# Set CLEVER_ADMIN_ALLOWED_SHOP_DOMAINS to explicit comma-separated Woo/shop domains.
# Leaving it blank fails closed; use * only for a deliberate, reviewed compatibility exception.
CLEVER_ADMIN_API_TOKEN=
CLEVER_ADMIN_API_ACTOR=internal-operator
CLEVER_ADMIN_ALLOWED_SHOP_DOMAINS=
# Same-host browser admin UI secrets. Keep separate from CLEVER_ADMIN_API_TOKEN.
CLEVER_ADMIN_WEB_LOGIN_SECRET=
CLEVER_ADMIN_WEB_SESSION_SECRET=
CLEVER_ADMIN_WEB_COOKIE_NAME=clever_admin_ui
CLEVER_DSV_ENABLED=false
CLEVER_DSV_ROUTE_OPTIMIZATION_ENABLED=true
CLEVER_DSV_ROUTE_OPTIMIZATION_DEBOUNCE_MS=750
CLEVER_DSV_WEB_COOKIE_NAME=clever_dsv_admin
# Public DSV customer web origin used in account setup/reset emails. Must be an origin only.
CLEVER_DSV_WEB_PUBLIC_URL=
CLEVER_DSV_DEMO_SHOP_DOMAIN=dsv-demo.local
CLEVER_DSV_BOOTSTRAP_ADMIN_ID=
CLEVER_DSV_BOOTSTRAP_ADMIN_PASSWORD=
CLEVER_DSV_BOOTSTRAP_ADMIN_DISPLAY_NAME=
CLEVER_DSV_BOOTSTRAP_ADMIN_RESET=false
DELIVERY_API_PUBLIC_URL=
ROUTES_APP_DOWNLOAD_URL=
# Public Android release manifest at /routes-app/release/android. Legacy
# /driver-app clients receive the same manifest during the package migration.
# The manifest exposes only the stable /routes-app install guide, never
# ROUTES_APP_DOWNLOAD_URL.
# Production can bootstrap from these env values before the DB release registry
# is seeded. After that, publish current Android releases with:
# npm run routes-app:release:publish -- --version-code 2 --version-name 1.0.1 --minimum-version-code 1 --download-url https://downloads.example.com/clever-routes.apk --apk-sha256 <64-hex>
ROUTES_APP_DISTRIBUTION_CHANNEL=direct
ROUTES_APP_ANDROID_LATEST_VERSION_CODE=
ROUTES_APP_ANDROID_LATEST_VERSION_NAME=
ROUTES_APP_ANDROID_MIN_SUPPORTED_VERSION_CODE=
PRIVACY_CONTACT_EMAIL=

# Optional account-scoped driver route Push notifications. Production reads
# the Google service-account file from a read-only container mount.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional customer delivery notification sender for admin stop transitions.
# Leave CUSTOMER_DELIVERY_NOTIFICATION_URL blank to keep notifications queued.
# When configured, the PostgreSQL-backed worker claims and retries idempotent
# notifications outside the admin request path. The bearer token is optional
# and must be supplied only in runtime secret storage, never committed here.
CUSTOMER_DELIVERY_NOTIFICATION_URL=
# Set false to keep the automatic outbox worker stopped even when a sender URL is staged.
CUSTOMER_DELIVERY_NOTIFICATION_WORKER_ENABLED=true
CUSTOMER_DELIVERY_NOTIFICATION_BEARER_TOKEN=
CUSTOMER_DELIVERY_NOTIFICATION_TIMEOUT_MS=
SHOPIFY_WEBHOOK_TERMINAL_RETENTION_DAYS=30

# Driver proof media storage backend. Each environment uses this same adjacent
# application env contract; production may select an absolute bind-mounted path.
# Use s3 only after private bucket/IAM evidence is approved.
DRIVER_PROOF_MEDIA_STORAGE_BACKEND=local
DRIVER_PROOF_MEDIA_STORAGE_DIR=var/driver-proof-media
DRIVER_PROOF_MEDIA_S3_BUCKET=
DRIVER_PROOF_MEDIA_S3_REGION=
DRIVER_PROOF_MEDIA_S3_ACCESS_KEY_ID=
DRIVER_PROOF_MEDIA_S3_SECRET_ACCESS_KEY=
DRIVER_PROOF_MEDIA_S3_ENDPOINT=
DRIVER_PROOF_MEDIA_S3_FORCE_PATH_STYLE=false
DRIVER_PROOF_MEDIA_S3_SESSION_TOKEN=
DRIVER_PROOF_MEDIA_READ_ACCESS_TTL_SECONDS=300
DRIVER_PROOF_MEDIA_RESERVATIONS_ENABLED=false
DRIVER_PROOF_MEDIA_RETENTION_DAYS=180
DRIVER_PROOF_MEDIA_SCANNER_BACKEND=none
DRIVER_PROOF_MEDIA_SCANNER_URL=
DRIVER_PROOF_MEDIA_SCANNER_BEARER_TOKEN=
DRIVER_PROOF_MEDIA_SCAN_MONITOR_BACKEND=none
DRIVER_PROOF_MEDIA_SCAN_MONITOR_URL=
DRIVER_PROOF_MEDIA_SCAN_MONITOR_BEARER_TOKEN=
DRIVER_PROOF_MEDIA_CLEANUP_EVIDENCE_REF=

# Optional first-slice driver route map preview. When enabled, assigned-route
# responses include a short-lived signed PNG URL generated from stored route
# geometry. DELIVERY_API_PUBLIC_URL must be a trusted http(s) origin because
# preview URLs are never minted from forwarded request hosts. Set a separate
# preview secret before production rotation; blank falls back to JWT_SECRET.
# The mobile app treats missing/expired previews as non-blocking.
DRIVER_ROUTE_MAP_PREVIEW_ENABLED=false
DRIVER_ROUTE_MAP_PREVIEW_SECRET=
DRIVER_ROUTE_MAP_PREVIEW_TTL_SECONDS=600

# Optional legacy Shopify compatibility. Leave unset for the WordPress/Woo main server
# unless running legacy Shopify token/webhook/order-sync compatibility paths.
SHOPIFY_API_VERSION=2026-07
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_DEV_API_KEY=
SHOPIFY_DEV_API_SECRET=
# Additional apps can be supplied as appId:clientId:clientSecret entries separated by commas.
SHOPIFY_APP_CREDENTIALS=
SHOPIFY_APP_URL=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_BODY_LIMIT_BYTES=5242880
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_TOKEN_EXCHANGE_TIMEOUT_MS=3000

# WooCommerce order ingestion defaults. Customer-specific Woo API keys/secrets belong
# in encrypted DB connector rows, not in shared product env files.
WOOCOMMERCE_SHOP_TIMEZONE=America/Toronto
WOOCOMMERCE_SYNC_LOOKBACK_DAYS=14

# Route Ops map provider contract. Leave unset for the disabled default.
ROUTE_OPS_MAP_STYLE_URL=
ROUTE_OPS_MAP_PROVIDER_MODE=
ROUTE_OPS_MAP_ALLOWED_HOSTS=
ROUTE_OPS_MAP_ATTRIBUTION=

# Route Ops optimizer. Blank VROOM_* values keep the local CLEVER v1 fallback active.
VROOM_BASE_URL=
VROOM_ONTARIO_BASE_URL=
VROOM_KOREA_BASE_URL=
VROOM_TIMEOUT_MS=180000
ROUTE_OPTIMIZATION_JOB_TIMEOUT_BUDGET_MS=180000

# Route Ops road geometry provider. Use per-coverage URLs for multi-country routing.
OSRM_BASE_URL=
OSRM_ONTARIO_BASE_URL=
OSRM_KOREA_BASE_URL=
OSRM_DEFAULT_COVERAGE=
OSRM_TIMEOUT_MS=10000
ROUTE_OPS_ROUTER_COVERAGE=ontario

# DSV v1 map profile. Leave unset to fail closed on
# GET /api/dsv/v1/map/profile. The API returns metadata only; it does not proxy
# or fetch tiles.
DSV_MAP_PROFILE_ID=
DSV_MAP_REGION_CODE=
DSV_MAP_PROVIDER_MODE=
DSV_MAP_STYLE_URL=
DSV_MAP_ATTRIBUTION=
DSV_MAP_VERSION=
DSV_MAP_BOUNDS=
DSV_MAP_INITIAL_CENTER=
DSV_MAP_INITIAL_ZOOM=
DSV_MAP_ALLOWED_HOSTS=

# Server-side geocoding provider. Korean DSV imports require structured address
# details so postal codes can be verified. Keep disabled unless explicitly
# configured for the active environment.
GEOCODING_PROVIDER_MODE=disabled
GEOCODING_SEARCH_URL=
GEOCODING_USER_AGENT=
# Keep 1 for public Nominatim. VWorld may use a higher bounded rate such as 5.
GEOCODING_RATE_LIMIT_PER_SECOND=1
GEOCODING_CACHE_TTL_DAYS=
GEOCODING_TIMEOUT_MS=10000
VWORLD_API_KEY=

# Optional UVIS vehicle GPS/temperature provider. Keep real company keys and vendor
# URLs only in runtime secret storage; these placeholders are intentionally blank.
UVIS_ENABLED=false
UVIS_APP_ID=clever
UVIS_SHOP_DOMAIN=
UVIS_ACCESS_KEY_URL=
UVIS_TELEMETRY_URL=
UVIS_ALLOWED_OUTBOUND_URLS=
UVIS_COMPANY_SERIAL_KEY=
UVIS_LOCATION_GUBUN=
UVIS_TEMPERATURE_GUBUN=
UVIS_TIMEOUT_MS=
UVIS_LOCATION_POLL_INTERVAL_MS=60000
UVIS_LOCATION_DORMANT_GRACE_PERIOD_MS=600000
UVIS_LOCATION_DORMANT_HEARTBEAT_INTERVAL_MS=300000
UVIS_TEMPERATURE_POLL_INTERVAL_MS=300000

# Korean DSV imports reuse the server geocoding provider. VWorld address
# search returns coordinates, canonical road/parcel labels, and postal codes.
# Optional Brevo configuration for administrator-triggered manual emails.
# No startup, schedule, automatic notification fact, or background event sends
# customer email through Brevo. Only explicit confirmed admin customer-email
# commands and Settings test sends use this key. Sender/reply-to settings are
# saved per shop in CLEVER DB; the API key stays server-side.
BREVO_API_KEY=
BREVO_TIMEOUT_MS=10000
BREVO_SENDER_NAME=CLEVER DSV
# Uploaded customer-email logo assets are content-addressed and publicly served
# from DELIVERY_API_PUBLIC_URL/customer-email/assets/:fileName.
CUSTOMER_EMAIL_ASSETS_DIR=var/customer-email-assets
# Optional comma-separated values used only to prefill the manual form.
DSV_MANUAL_EMAIL_DEFAULT_TO=
DRIVER_EVENT_ATTEMPT_RETENTION_DAYS=90
