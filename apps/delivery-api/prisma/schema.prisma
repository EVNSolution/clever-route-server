generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopifyWebhookEventStatus {
  RECEIVED
  QUEUED
  RETRY_WAIT
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DEAD_LETTER
}

enum ShopifyOrderReconciliationJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum ShopifyOrderReconciliationJobMode {
  INCREMENTAL
  FULL
}

enum CommerceSourcePlatform {
  SHOPIFY
  WOOCOMMERCE
}

enum CommerceConnectionStatus {
  ACTIVE
  DISABLED
}

enum CommerceSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum CommerceRawOrderIngestStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  SKIPPED
  FAILED
}

enum WordPressPluginTokenStatus {
  ACTIVE
  REVOKED
}

enum DeliveryOrderStatus {
  PENDING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum GeocodeStatus {
  NOT_REQUIRED
  PENDING
  RESOLVED
  FAILED
}

enum DeliveryStopStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  DELIVERED
  FAILED
  SKIPPED
