  INACTIVE
}

enum DsvCustomerAccountInvitePurpose {
  SIGNUP
  PASSWORD_RESET
}

enum DsvAdminAccountStatus {
  ACTIVE
  DISABLED
}

enum DsvTransportConditionStatus {
  CANDIDATE
  ACTIVE
  INACTIVE
}

enum DsvCommandReceiptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum DsvPrincipalType {
  DSV_ADMIN
  CUSTOMER_USER
  DRIVER
  IMPORT_WORKER
  DEVICE
  SYSTEM_WORKER
}

enum DsvAuditRedactionClass {
  STANDARD
  PII_REDACTED
  SECRET_REDACTED
}

enum DsvEtaStatus {
  NOT_REQUIRED
  PENDING
  READY
  FAILED
  STALE
}

enum DsvDispatchChangeRequestType {
  TIME_CONSTRAINT_CHANGE
  ACTIVE_ROUTE_ORDER_REMOVAL
}

enum DsvDispatchChangeRequestStatus {
  PENDING_ACK
  APPLIED
  CANCELLED
}

enum DriverBundleHandoffRequestStatus {
  PROPOSED
  PROCESSING
  REJECTED
  APPLIED
  CANCELLED
