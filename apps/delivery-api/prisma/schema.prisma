  applyReceipt    DsvCommandReceipt?         @relation("DsvDispatchImportRowApplyReceipt", fields: [applyReceiptId, shopId], references: [id, shopId], onDelete: NoAction)
  appliedAt       DateTime?                  @db.Timestamptz(6)
  canonicalLink   Json?
  candidateDiff   Json?
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(6)

  @@unique([importId, rowNumber])
  @@unique([importId, sellerOrderKey])
  @@index([importId, status, rowNumber])
  @@index([shopId, sellerOrderKey, createdAt])
  @@index([shopId, sellerOrderId])
  @@index([shopId, deliveryStopId])
  @@index([importId, diffKind, rowNumber])
  @@index([driverId])
  @@index([vehicleId])
  @@map("dsv_dispatch_import_rows")
}

model DsvCommandReceipt {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId                 String                     @db.Uuid
  shop                   Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  commandName            String                     @db.Text
  commandId              String                     @db.Text
  payloadHash            String                     @db.Text
  actorType              String                     @db.Text
  actorId                String?                    @db.Text
  principalType          DsvPrincipalType
  requestId              String                     @db.Text
  status                 DsvCommandReceiptStatus    @default(STARTED)
  resultEntityType       String?                    @db.Text
  resultEntityId         String?                    @db.Text
  responseStatus         Int?
  responseBodyRef        String?                    @db.Text
  importId               String?                    @db.Uuid
  importRecord           DsvDispatchImport?         @relation("DsvCommandReceiptImport", fields: [importId, shopId], references: [id, shopId], onDelete: NoAction)
  sellerOrderId          String?                    @db.Uuid
  sellerOrder            Order?                     @relation(fields: [sellerOrderId, shopId], references: [id, shopId], onDelete: NoAction)
  previousRoutePlanId    String?                    @db.Uuid
  previousRoutePlan      RoutePlan?                 @relation("DsvCommandReceiptPreviousRoutePlan", fields: [previousRoutePlanId, shopId], references: [id, shopId], onDelete: NoAction)
  nextRoutePlanId        String?                    @db.Uuid
  nextRoutePlan          RoutePlan?                 @relation("DsvCommandReceiptNextRoutePlan", fields: [nextRoutePlanId, shopId], references: [id, shopId], onDelete: NoAction)
  previousRouteVersionId String?                    @db.Uuid
  previousRouteVersion   RouteGroupingChildVersion? @relation("DsvCommandReceiptPreviousRouteVersion", fields: [previousRouteVersionId, shopId], references: [id, shopId], onDelete: NoAction)
  nextRouteVersionId     String?                    @db.Uuid
  nextRouteVersion       RouteGroupingChildVersion? @relation("DsvCommandReceiptNextRouteVersion", fields: [nextRouteVersionId, shopId], references: [id, shopId], onDelete: NoAction)
  createdAt              DateTime                   @default(now()) @db.Timestamptz(6)
  completedAt            DateTime?                  @db.Timestamptz(6)
  retainedUntil          DateTime?                  @db.Timestamptz(6)
  auditEvents            DsvAuditEvent[]
  appliedImports         DsvDispatchImport[]        @relation("DsvDispatchImportApplyReceipt")
  appliedImportRows      DsvDispatchImportRow[]     @relation("DsvDispatchImportRowApplyReceipt")
  dispatchChangeRequests DsvDispatchChangeRequest[]

  @@unique([id, shopId])
  @@unique([shopId, commandName, commandId])
  @@index([shopId, status, createdAt])
  @@index([shopId, requestId])
  @@index([shopId, sellerOrderId, createdAt])
  @@index([shopId, retainedUntil])
  @@map("dsv_command_receipts")
}

model DsvAuditEvent {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId                 String                     @db.Uuid
  shop                   Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  eventType              String                     @db.Text
  entityType             String                     @db.Text
  entityId               String                     @db.Text
  sellerOrderId          String?                    @db.Uuid
  sellerOrder            Order?                     @relation(fields: [sellerOrderId, shopId], references: [id, shopId], onDelete: NoAction)
  customerId             String?                    @db.Uuid
  customer               Customer?                  @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: NoAction)
  destinationId          String?                    @db.Uuid
  destination            DeliveryCustomerProfile?   @relation(fields: [destinationId, shopId], references: [id, shopId], onDelete: NoAction)
  actorType              String                     @db.Text
  actorId                String?                    @db.Text
  principalType          DsvPrincipalType
  requestId              String                     @db.Text
  commandReceiptId       String?                    @db.Uuid
  commandReceipt         DsvCommandReceipt?         @relation(fields: [commandReceiptId, shopId], references: [id, shopId], onDelete: NoAction)
  importId               String?                    @db.Uuid
  importRecord           DsvDispatchImport?         @relation(fields: [importId, shopId], references: [id, shopId], onDelete: NoAction)
  previousRoutePlanId    String?                    @db.Uuid
  previousRoutePlan      RoutePlan?                 @relation("DsvAuditEventPreviousRoutePlan", fields: [previousRoutePlanId, shopId], references: [id, shopId], onDelete: NoAction)
  nextRoutePlanId        String?                    @db.Uuid
  nextRoutePlan          RoutePlan?                 @relation("DsvAuditEventNextRoutePlan", fields: [nextRoutePlanId, shopId], references: [id, shopId], onDelete: NoAction)
  previousRouteVersionId String?                    @db.Uuid
  previousRouteVersion   RouteGroupingChildVersion? @relation("DsvAuditEventPreviousRouteVersion", fields: [previousRouteVersionId, shopId], references: [id, shopId], onDelete: NoAction)
  nextRouteVersionId     String?                    @db.Uuid
  nextRouteVersion       RouteGroupingChildVersion? @relation("DsvAuditEventNextRouteVersion", fields: [nextRouteVersionId, shopId], references: [id, shopId], onDelete: NoAction)
  redactedDiff           Json?
  beforeSnapshotRef      String?                    @db.Text
  afterSnapshotRef       String?                    @db.Text
  reason                 String?                    @db.Text
  occurredAt             DateTime                   @default(now()) @db.Timestamptz(6)
  retainedUntil          DateTime?                  @db.Timestamptz(6)
  redactionClass         DsvAuditRedactionClass     @default(STANDARD)

  @@index([shopId, eventType, occurredAt])
  @@index([shopId, entityType, entityId, occurredAt])
  @@index([shopId, sellerOrderId, occurredAt])
  @@index([shopId, customerId, occurredAt])
  @@index([shopId, destinationId, occurredAt])
  @@index([shopId, commandReceiptId])
  @@index([shopId, requestId])
  @@index([shopId, retainedUntil])
  @@map("dsv_audit_events")
}

model DsvDispatchChangeRequest {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId               String                         @db.Uuid
  shop                 Shop                           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  commandReceiptId     String                         @db.Uuid
  commandReceipt       DsvCommandReceipt              @relation(fields: [commandReceiptId, shopId], references: [id, shopId], onDelete: NoAction)
  sellerOrderId        String                         @db.Uuid
  sellerOrder          Order                          @relation(fields: [sellerOrderId, shopId], references: [id, shopId], onDelete: NoAction)
  deliveryStopId       String                         @db.Uuid
  deliveryStop         DeliveryStop                   @relation(fields: [deliveryStopId, shopId], references: [id, shopId], onDelete: NoAction)
  routePlanId          String                         @db.Uuid
  routeVersionId       String                         @db.Uuid
  driverId             String?                        @db.Uuid
  type                 DsvDispatchChangeRequestType
  status               DsvDispatchChangeRequestStatus @default(PENDING_ACK)
  timeWindowStart      DateTime?                      @db.Timestamptz(6)
  timeWindowEnd        DateTime?                      @db.Timestamptz(6)
  removalReason        String?                        @db.Text
  priorSnapshot        Json
  requestedByActorType String                         @db.Text
  requestedByActorId   String?                        @db.Text
  requestId            String                         @db.Text
  appliedDriverEventId String?                        @db.Uuid
  appliedDriverEvent   DriverEvent?                   @relation("DsvDispatchChangeRequestAppliedDriverEvent", fields: [appliedDriverEventId], references: [id], onDelete: NoAction)
  appliedAt            DateTime?                      @db.Timestamptz(6)
  createdAt            DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                       @updatedAt @db.Timestamptz(6)

  @@unique([shopId, commandReceiptId])
  @@unique([shopId, appliedDriverEventId])
  @@index([shopId, status, routePlanId, deliveryStopId, createdAt])
  @@index([shopId, sellerOrderId, status])
  @@map("dsv_dispatch_change_requests")
}

model DriverEvent {
  id                            String                     @id @default(uuid()) @db.Uuid
  shopId                        String                     @db.Uuid
  shop                          Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  driverId                      String?                    @db.Uuid
  driver                        Driver?                    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routePlanId                   String?                    @db.Uuid
  routePlan                     RoutePlan?                 @relation(fields: [routePlanId, shopId], references: [id, shopId], onDelete: NoAction)
  routeVersionId                String?                    @db.Uuid
  routeVersion                  RouteGroupingChildVersion? @relation("DriverEventRouteVersion", fields: [routeVersionId, shopId, routePlanId], references: [id, shopId, routePlanId], onDelete: NoAction)
  deliveryStopId                String?                    @db.Uuid
  deliveryStop                  DeliveryStop?              @relation(fields: [deliveryStopId], references: [id], onDelete: SetNull)
  clientEventId                 String?                    @db.Text
  eventType                     DriverEventType
  occurredAt                    DateTime                   @db.Timestamptz(6)
  latitude                      Decimal?                   @db.Decimal(10, 7)
  longitude                     Decimal?                   @db.Decimal(10, 7)
  payload                       Json
  createdAt                     DateTime                   @default(now()) @db.Timestamptz(6)
  appliedDispatchChangeRequests DsvDispatchChangeRequest[] @relation("DsvDispatchChangeRequestAppliedDriverEvent")

  @@unique([driverId, clientEventId])
  @@index([shopId, routePlanId, occurredAt])
  @@index([shopId, routeVersionId, occurredAt])
  @@index([shopId, deliveryStopId, occurredAt])
  @@map("driver_events")
}
