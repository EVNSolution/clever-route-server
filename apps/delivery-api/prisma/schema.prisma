}

enum OrderDeliveryFactReadiness {
  READY_TO_PLAN
  NEEDS_REVIEW
  SKIPPED
}

enum RoutePlanStatus {
  /// Legacy DB value retained for backward-compatible reads; app code must not create it.
  DRAFT
  /// Legacy DB value retained for backward-compatible reads; app code must not create it.
  PUBLISHED
  CANCELLED
  /// Legacy DB value retained so prisma db push stays non-destructive; app code must not create it.
  OPTIMIZED
  /// Legacy DB value retained so prisma db push stays non-destructive; app code must not create it.
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  READY
}

enum RouteOptimizationJobStatus {
  QUEUED
  RUNNING
  APPLIED
  TIMEOUT
  FAILED
  CANCELLED
}

enum RouteOptimizationJobStep {
  QUEUED
  CALLING_ENGINE
  APPLYING_RESULT
  COMPLETED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VehicleType {
