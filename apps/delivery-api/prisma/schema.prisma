  TEMPERATURE_RECORDER
}

enum UvisTelemetryActivity {
  ACTIVE
  DORMANT
}

enum DriverEventType {
  ROUTE_STARTED
  ROUTE_PAUSED
  ROUTE_COMPLETED
  PICKUP_COMPLETED
  TIME_CONSTRAINT_ACKNOWLEDGED
  DISPATCH_CHANGE_ACKNOWLEDGED
  STOP_ARRIVED
  STOP_DELIVERED
  STOP_FAILED
  LOCATION_UPDATED
  NOTE_ADDED
}

enum DriverConsentType {
  LOCATION_INFORMATION
  PERSONAL_INFORMATION
}

enum OrderMessageAudience {
  DRIVER
  CUSTOMER
}

enum DriverProofMediaKind {
