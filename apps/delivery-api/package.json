{
  "name": "clever-route-delivery-api",
  "version": "0.1.0",
  "description": "CLEVER route delivery API server for driver, routing, and commerce-source integrations.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:disposable": "bash scripts/test-disposable-db-integrations.sh",
    "check:workspace": "npm run prisma:generate && npm run prisma:validate && npm run lint && npm run typecheck && npm run test",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://clever:clever@localhost:5432/clever_route} prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://clever:clever@localhost:5432/clever_route} prisma validate",
    "driver:proof-media:cleanup": "node dist/scripts/cleanup-driver-proof-media.js",
    "shopify:webhook-events:cleanup": "node dist/scripts/cleanup-shopify-webhook-events.js",
    "driver:event-contract:verify": "tsx src/scripts/verify-driver-event-contract.ts",
    "driver:event-attempts:cleanup": "node dist/scripts/cleanup-driver-event-attempts.js",
    "driver:route-completion-invariant:report": "tsx src/scripts/report-driver-route-completion-invariant.ts",
    "customer-email:reconcile": "tsx src/scripts/reconcile-customer-email.ts",
    "driver:proof-media:evidence:seed": "tsx src/scripts/proof-media-evidence-seed.ts",
    "driver:proof-media:evidence:verify": "tsx src/scripts/proof-media-evidence-verify.ts",
    "dsv:dispatch-demo:seed": "tsx src/scripts/seed-dsv-dispatch-demo.ts",
    "dsv:admin-account:bootstrap": "tsx src/scripts/bootstrap-dsv-admin-account.ts",
    "dsv:driver-auth:smoke": "tsx src/scripts/smoke-dsv-driver-auth.ts",
    "dsv:driver-app-release:publish": "tsx src/scripts/publish-dsv-driver-app-release.ts",
    "routes-app:release:publish": "tsx src/scripts/publish-routes-app-release.ts",
    "dsv:dispatch-demo:smoke": "tsx src/scripts/smoke-dsv-dispatch-import.ts",
    "dsv:g002:backfill:dry-run": "tsx src/scripts/dsv-g002-backfill-dry-run.ts",
    "dsv:g002:baseline:empty": "bash scripts/dsv-g002-empty-baseline-rehearsal.sh",
    "dsv:g002:drift:prod-like": "bash scripts/dsv-g002-prod-like-expand-rehearsal.sh",
    "woocommerce:connection:bootstrap": "tsx src/scripts/bootstrap-woocommerce-connection.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "wordpress-plugin:pairing-code:create": "tsx src/scripts/create-wordpress-plugin-pairing-code.ts",
    "woocommerce:delivery-facts:evidence": "tsx src/scripts/woocommerce-delivery-facts-evidence.ts",
    "woocommerce:order-items:backfill": "tsx src/scripts/backfill-woocommerce-order-items.ts",
    "route-geometry:refresh": "node dist/scripts/refresh-route-geometry-cache.js",
    "orders:display-sequence:backfill": "tsx src/scripts/backfill-order-display-sequence.ts",
    "route-groups:custom-ownership:audit": "tsx src/scripts/audit-custom-route-order-ownership.ts",
    "uvis:vehicle-trails:backfill": "tsx src/scripts/backfill-uvis-vehicle-trails.ts",
    "perf:orders:cohorts": "tsx src/scripts/orders-performance-cohorts.ts",
    "perf:orders:completion-evidence": "tsx src/scripts/orders-pagination-completion-evidence.ts"
  },
  "keywords": [
    "delivery",
    "routing",
    "routes-app",
    "woocommerce",
    "fastify",
    "typescript"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.8.5",
    "firebase-admin": "^14.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "eslint": "^10.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
